<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Windows 11 Setup/Debloat Tool" Height="720" Width="1040"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#181818"/>
        <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
        <SolidColorBrush x:Key="CardBg" Color="#2E2E31"/>
        <SolidColorBrush x:Key="Border" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="SubText" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
        <SolidColorBrush x:Key="NavHover" Color="#333333"/>
        <SolidColorBrush x:Key="NavActive" Color="#4A4A4E"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="2,2,2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="2" BorderBrush="{StaticResource SubText}" Background="{StaticResource PanelBg}" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path x:Name="CheckMark" Data="M 0,0 L 16,16 M 16,0 L 0,16" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBg}" BorderThickness="1.5" CornerRadius="8" Padding="16,14,16,14">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="36" Height="18" CornerRadius="9" BorderThickness="1.5"
                                BorderBrush="{StaticResource SubText}" Background="{StaticResource PanelBg}">
                            <Ellipse x:Name="Knob" Width="10" Height="10" Margin="3,0,3,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource SubText}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,4,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid TextElement.Foreground="{StaticResource Text}">
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{StaticResource Text}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource CardBg}" BorderThickness="1.5" CornerRadius="6" Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{StaticResource Text}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="{StaticResource NavActive}" CornerRadius="4" Margin="1,0,1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}" TextElement.FontSize="14" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <StackPanel Margin="18,18,18,18">
                        <Image x:Name="SidebarLogo" Width="164" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,8" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                        <StackPanel x:Name="SidebarTitleText">
                            <TextBlock Text="Simple Windows 11 Setup/Debloat Tool" Foreground="{StaticResource Text}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="By PaladinXV" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="NavInfo" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Home" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRestore" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Restore Point" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavApps" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Windows Apps" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavConfig" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Configuration" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPrograms" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="User Apps" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavShortcuts" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Shortcuts" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,12,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Panel.ZIndex="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-3,0,0" VerticalAlignment="Top">
                    <StackPanel x:Name="SearchPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Search" Foreground="{StaticResource Text}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Width="176" Height="34" FontSize="14" Margin="0,0,20,0" Padding="8,2,8,2" VerticalAlignment="Center" Background="{StaticResource PanelBg}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource CardBg}" CaretBrush="{StaticResource Text}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="6">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>
                    <TextBlock Text="Zoom" Foreground="{StaticResource Text}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ZoomCombo" Width="90" Height="34" FontSize="14" VerticalAlignment="Center" SelectedIndex="2">
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid x:Name="PageInfo" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Simple Windows 11 Setup/Debloat Tool" Style="{StaticResource PageTitle}" FontSize="22" Margin="0"/>
                            <TextBlock Text="By PaladinXV" Foreground="{StaticResource SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="900"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource SubText}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,18" Text="An open-source, interactive tool that can modify Windows to your liking."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button x:Name="InfoGoRestore" Style="{StaticResource InfoCard}" Grid.Row="0" Grid.Column="0">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Restore Point" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="Before you start, create a System Restore Point to roll back to if anything goes wrong." Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBg}" BorderThickness="1.5" CornerRadius="8" Padding="16,14,16,14" Margin="0,0,12,12" Grid.Row="2" Grid.Column="0">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Quick Presets" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="Select a preset and go!" Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,12"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="BtnQuickRecommended" Content="Recommended" Height="30" MinWidth="0" Padding="14,0"/>
                                                        <Button x:Name="BtnQuickAggressive" Content="Aggressive" Height="30" MinWidth="0" Padding="14,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="InfoGoApps" Style="{StaticResource InfoCard}" Grid.Row="0" Grid.Column="1">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Windows Apps" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="Uninstall or reinstall Windows apps such as OneDrive, Copilot, Edge etc." Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBg}" BorderThickness="1.5" CornerRadius="8" Padding="16,14,16,14" Margin="0,0,12,12" Grid.Row="2" Grid.Column="1">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="User Presets" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="Create/Import a custom preset." Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,12"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="BtnImportConfig" Content="Import config" Height="30" MinWidth="0" Padding="14,0"/>
                                                        <Button x:Name="BtnExportConfig" Content="Export config" Height="30" MinWidth="0" Padding="14,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="InfoGoConfig" Style="{StaticResource InfoCard}" Grid.Row="1" Grid.Column="0">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Configuration" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="Configure Windows settings to your liking, or start from one of two presets." Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="InfoGoShortcuts" Style="{StaticResource InfoCard}" Grid.Row="3" Grid.Column="0">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Shortcuts" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="Quick links to useful Windows settings and tools." Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="InfoGoPrograms" Style="{StaticResource InfoCard}" Grid.Row="1" Grid.Column="1">
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="User Apps" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                    <TextBlock Text="Install your apps via Winget or Chocolatey." Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,12" Text="Have a suggestion? Please feel free to contact me."/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer x:Name="PageShortcuts" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}"/>
                            <TextBlock Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,18" Text="Quick links to Windows settings pages and classic Control Panel tools."/>
                            <StackPanel x:Name="ShortcutsList"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="PageRestore" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Restore Point" Style="{StaticResource PageTitle}"/>
                            <TextBlock Foreground="{StaticResource SubText}" TextWrapping="Wrap" Text="Create a restore point that lets you revert Windows system settings to an earlier state."/>
                            <TextBlock Foreground="#FF9500" TextWrapping="Wrap" Margin="0,6,0,0" Text="Windows can only create a restore point every 24 hours."/>
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="BtnRestorePoint" Content="Create Restore Point"/>
                                <Button x:Name="BtnCheckRestorePoints" Content="Check Restore Points"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="620"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="20,16,20,18" Margin="0,16,12,12">
                                    <StackPanel>
                                        <TextBlock Text="Recent Restore Points" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="RestorePointList"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="PageApps" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Windows Apps" Style="{StaticResource PageTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnAppsUninstall" Content="Uninstall" BorderBrush="{StaticResource Accent}"/>
                                <Button x:Name="BtnAppsInstall" Content="Install"/>
                                <Button x:Name="BtnDetectApps" Content="Detect Installed Apps"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="700"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="0.001*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0" Padding="0" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}">
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel x:Name="AppsUninstallList" Visibility="Visible"/>
                                    <StackPanel x:Name="AppsInstallList" Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="6" Padding="18,14,18,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock x:Name="AppsDescTitle" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Text="Hover an item"/>
                                    <TextBlock x:Name="AppsDescBody" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Descriptions will appear here as you hover over items on the left."/>
                                    <DockPanel x:Name="AppsDescSafetyRow" LastChildFill="True" Visibility="Collapsed">
                                        <Ellipse x:Name="AppsDescSafetyDot" DockPanel.Dock="Left" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,7,0"/>
                                        <TextBlock x:Name="AppsDescSafetyText" FontSize="12" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid x:Name="PageConfig" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Configuration" Style="{StaticResource PageTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnDetectTweaks" Content="Detect Current Tweaks"/>
                                <Button x:Name="BtnRevertAll" Content="Set Defaults"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="260" MaxWidth="700"/>
                                <ColumnDefinition Width="*" MinWidth="280"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0" Padding="0" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}">
                                <StackPanel x:Name="ConfigTweaksCol" Margin="0,0,14,0"/>
                            </ScrollViewer>
                            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="6" Padding="18,14,18,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock x:Name="ConfigDescTitle" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Text="Hover an item"/>
                                    <TextBlock x:Name="ConfigDescBody" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8" Text="Descriptions will appear here as you hover over items on the left."/>
                                    <DockPanel x:Name="ConfigDescSafetyRow" LastChildFill="True" Visibility="Collapsed">
                                        <Ellipse x:Name="ConfigDescSafetyDot" DockPanel.Dock="Left" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,7,0"/>
                                        <TextBlock x:Name="ConfigDescSafetyText" FontSize="12" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid x:Name="PagePrograms" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="User Apps" Style="{StaticResource PageTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="BtnSourceWinget" Content="Winget" BorderBrush="{StaticResource Accent}"/>
                                <Button x:Name="BtnSourceChoco" Content="Chocolatey"/>
                                <StackPanel x:Name="ProgramsWingetTool" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel x:Name="ProgramsChocoTool" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="700"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="0.001*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0" Padding="0" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}">
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel x:Name="ProgramsWingetList" Visibility="Visible"/>
                                    <StackPanel x:Name="ProgramsChocoList" Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="6" Padding="18,14,18,14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock x:Name="ProgramsDescTitle" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Text="Hover an item"/>
                                    <TextBlock x:Name="ProgramsDescBody" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Text="Descriptions will appear here as you hover over items on the left."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <DockPanel LastChildFill="True" Margin="10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnClearPreset" Content="Clear Preset" Visibility="Collapsed"/>
                        <Button x:Name="BtnRecommended" Content="Recommended"/>
                        <Button x:Name="BtnAggressive" Content="Aggressive"/>
                        <Button x:Name="BtnBasic" Content="Basic" Visibility="Collapsed"/>
                        <Button x:Name="BtnAll" Content="All"/>
                        <Button x:Name="BtnNone" Content="None"/>
                        <StackPanel x:Name="SafetyLegend" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Safe" Foreground="{StaticResource SubText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Ellipse Width="8" Height="8" Fill="#FF9500" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Advanced" Foreground="{StaticResource SubText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Ellipse Width="8" Height="8" Fill="#FF3B30" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Not Recommended" Foreground="{StaticResource SubText}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnApply" Content="Apply Selected" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    <Button x:Name="BtnApplyConfig" Content="Apply" DockPanel.Dock="Right" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    <Button x:Name="BtnOpenLog" Content="Open Log" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="0" Padding="14,0"/>
                </DockPanel>
            </Grid>
        </Border>

        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#B4000000" Visibility="Collapsed">
            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="32,26,32,26" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid>
                <StackPanel>
                    <StackPanel x:Name="OverlayTitleRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse x:Name="Spinner" Width="20" Height="20" StrokeThickness="2.5"
                                 Stroke="{StaticResource Accent}" StrokeDashArray="6.5 16"
                                 StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                 VerticalAlignment="Center" Margin="0,0,11,0">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="OverlayTick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                   Foreground="#34C759" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="OverlayTitle" Text="Processing Selected Items" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="6"
                                 BorderThickness="0" Background="{StaticResource CardBg}"
                                 Foreground="{StaticResource Accent}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock x:Name="OverlayDetail" Text="" HorizontalAlignment="Center" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,12,0,0"
                               Foreground="{StaticResource SubText}"/>
                    <TextBlock x:Name="OverlayNote" Visibility="Collapsed"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="12" Margin="0,8,0,0" Foreground="#FF9500"/>
                    <TextBlock x:Name="OverlaySummary" Visibility="Collapsed" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubText}" Margin="0"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18"/>
                    <StackPanel x:Name="OverlayRunButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BtnOverlaySkip" Content="Skip" Height="36" MinWidth="110"/>
                        <Button x:Name="BtnOverlayCancel" Content="Cancel" Height="36" MinWidth="110"/>
                    </StackPanel>
                    <Button x:Name="BtnOverlayClose" Content="Close"
                            Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Height="40" MinWidth="130" FontSize="14"/>
                </StackPanel>
              </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
